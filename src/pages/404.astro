---
import "../styles/global.css";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import VirtusApex from "../assets/virtus-apex-logo-tecnologia.png";

const home = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---

<Layout title="Página não encontrada | Virtus Apex">
	<main class="not-found">
		<a href={home} aria-label="Virtus Apex: voltar ao início">
			<Image
				src={VirtusApex}
				alt="Virtus Apex"
				width={240}
				loading="eager"
				class="not-found-logo"
			/>
		</a>

		<p class="not-found-code">404</p>
		<h1 class="not-found-title">Esta página não existe.</h1>
		<p class="not-found-text">
			O endereço pode ter mudado ou sido digitado errado. Volte ao início
			ou fale direto com a nossa equipe.
		</p>

		<div class="not-found-actions">
			<a href={home} class="not-found-btn not-found-btn--primary">
				Voltar ao início
			</a>
			<a
				href="https://wa.me/5562981752097?text=Oi%21+Vim+pelo+site+da+Virtus+Apex+e+quero+conversar."
				target="_blank"
				rel="noopener noreferrer"
				class="not-found-btn"
			>
				Falar no WhatsApp
			</a>
		</div>
	</main>
</Layout>

<style>
	.not-found {
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 16px;
		padding: 48px 16px;
		text-align: center;
		background: #06060e;
		font-family: "Paralucent", sans-serif;
	}

	.not-found-logo {
		width: 200px;
		height: auto;
		margin-bottom: 24px;
	}

	.not-found-code {
		margin: 0;
		font-size: 14px;
		letter-spacing: 0.3em;
		color: #9aebf7;
	}

	.not-found-title {
		margin: 0;
		font-size: clamp(32px, 6vw, 56px);
		font-weight: 500;
		line-height: 1.1;
		color: #e8ebf0;
	}

	.not-found-text {
		margin: 0;
		max-width: 460px;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.6;
		color: #abaeb4;
	}

	.not-found-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 16px;
	}

	.not-found-btn {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: 12px 28px;
		background: #1a1c22;
		border: 1px solid #2a2d35;
		border-radius: 999px;
		color: #e8ebf0;
		font-size: 15px;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			transform 0.15s ease;
	}

	.not-found-btn:hover {
		background: #22242c;
		border-color: #3a3d45;
	}

	.not-found-btn:active {
		transform: scale(0.97);
	}

	.not-found-btn--primary {
		border-color: #9aebf7;
		color: #9aebf7;
	}
</style>
