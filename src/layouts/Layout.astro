---
// 1. IMPORTANDO O CSS DO TAILWIND
// Isso avisa pro site carregar os estilos globais
import "../styles/global.css";
import LoaderScreen from "../components/LoaderScreen.astro";

// 2. DEFININDO AS PROPRIEDADES
// Isso permite que você mude o título da aba do navegador em cada página
interface Props {
	title: string;
}

const { title } = Astro.props;

// Prefixo do site quando ele roda numa subpasta (vazio no domínio próprio)
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalPath = Astro.url.pathname.slice(base.length) || "/";
// Cópias de visualização (ex.: GitHub Pages) não devem concorrer com o domínio oficial no Google
const noindex = import.meta.env.PUBLIC_NOINDEX === "true";
---

<!doctype html>
<html lang="pt-br">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Método Apex: tecnologia e estratégia comercial para atrair, atender, organizar e medir. Sites, chatbot com IA no WhatsApp e CRM sob medida."
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#06060E" />
		<link rel="icon" type="image/x-icon" href={`${base}/logo-apex.ico`} />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<link rel="canonical" href={new URL(canonicalPath, "https://virtusapex.com")} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph / WhatsApp / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="Virtus Apex" />
		<meta property="og:url" content="https://virtusapex.com/" />
		<!-- Substitua pelo seu domínio oficial -->
		<meta property="og:title" content="Virtus Apex" />
		<meta
			property="og:description"
			content="Método Apex: tecnologia e estratégia comercial para atrair, atender, organizar e medir. Sites, chatbot com IA no WhatsApp e CRM sob medida."
		/>
		<meta
			property="og:image"
			content="https://virtusapex.com/og-image.png?v=2"
		/>
		<!-- Adicione sua imagem de capa (ex: 1200x630) na pasta public com o nome og-image.png -->

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://virtusapex.com/" />
		<meta property="twitter:title" content="Virtus Apex" />
		<meta
			property="twitter:description"
			content="Método Apex: tecnologia e estratégia comercial para atrair, atender, organizar e medir. Sites, chatbot com IA no WhatsApp e CRM sob medida."
		/>
		<meta
			property="twitter:image"
			content="https://virtusapex.com/og-image.png?v=2"
		/>

		<title>{title}</title>
	</head>
	<body>
		<LoaderScreen />
		<slot />
		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const observerOptions = {
					root: null,
					rootMargin: "0px",
					threshold: 0.15,
				};

				const observer = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							}
						});
					},
					observerOptions,
				);

				document
					.querySelectorAll(".animate-on-scroll")
					.forEach((el) => {
						observer.observe(el);
					});
			});
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Paralucent";
		src: url("/src/fonts/fonnts.com-Paralucent_Medium.otf")
			format("opentype");
		font-weight: medium;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Paralucent";
		src: url("/src/fonts/fonnts.com-Paralucent_Light.otf")
			format("opentype");
		font-weight: light;
		font-style: normal;
		font-display: swap;
	}

	html {
		scroll-behavior: smooth;
	}
	/* Sem "height: 100%": com ele o <body> virava o contêiner de rolagem,
	   o que impede a barra do navegador mobile de recolher e quebra o scroll da janela */
	html,
	body {
		margin: 0;
		width: 100%;
		overflow-x: hidden;
	}
	@supports (overflow-x: clip) {
		html,
		body {
			overflow-x: clip;
		}
	}

	/* Animation utility classes */
	.animate-on-scroll {
		opacity: 0;
		transform: translateY(30px);
		transition:
			opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity, transform;
	}

	.animate-on-scroll.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.delay-100 {
		transition-delay: 100ms;
	}
	.delay-200 {
		transition-delay: 200ms;
	}
	.delay-300 {
		transition-delay: 300ms;
	}

	/* Respeita quem pediu menos movimento no sistema */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		.animate-on-scroll {
			opacity: 1;
			transform: none;
			transition: none;
		}
		.animate-infinite-scroll {
			animation-play-state: paused;
		}
	}
</style>
